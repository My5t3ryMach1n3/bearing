{
  "name": "bearing-cli",
  "version": "0.1.0-rc.3",
  "description": "GitOps for architecture: reconcile every PR against an approved C4 target architecture.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bearing": "dist/cli.js"
  },
  "files": [
    "dist",
    "go",
    "!go/**/*_test.go",
    "python",
    "!python/**/__pycache__",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/My5t3ryMach1n3/bearing.git"
  },
  "bugs": {
    "url": "https://github.com/My5t3ryMach1n3/bearing/issues"
  },
  "homepage": "https://github.com/My5t3ryMach1n3/bearing#readme",
  "keywords": [
    "architecture",
    "c4",
    "structurizr",
    "drift",
    "cli"
  ],
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "elkjs": "0.9.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsdom": "31.0.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
